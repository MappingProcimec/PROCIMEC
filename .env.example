# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google Drive ─────────────────────────────────────────────────────────────
# Email del admin principal de Drive (propietario de los archivos)
GOOGLE_DRIVE_ADMIN_EMAIL=
# Token de refresco del admin (se obtiene en el primer login del admin)
GOOGLE_DRIVE_ADMIN_REFRESH_TOKEN=
# ID de la carpeta raíz en Drive donde se guardan los proyectos
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# JSON de cuenta de servicio (alternativa al OAuth admin)
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Administradores adicionales ──────────────────────────────────────────────
# Lista de correos con rol admin separados por coma (además de GOOGLE_DRIVE_ADMIN_EMAIL)
ADMIN_EMAILS=correo1@ejemplo.com,correo2@ejemplo.com
